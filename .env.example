# Docker deployment only. Copy to .env at the repository root and edit.
# Local development continues to use backend/.env.
APP_ORIGIN=https://memties.example.com
MYSQL_PASSWORD=replace-with-a-long-random-password
# Use the same password as above, URL-encoded in this connection string.
DOCKER_DATABASE_URL=mysql://memties:replace-with-a-long-random-password@db:3306/memties
ALLOW_REGISTRATION=true
LOG_FORMAT=json
LOG_LEVEL=info
# Add optional SMTP, LDAP, SAML or VAPID settings from backend/.env.example here.
