# Docker deployment only. Copy to .env at the repository root and edit.
# Local development continues to use backend/.env.
# Existing application configuration file on the Docker server.
APP_ENV_FILE=/opt/memties/.env
# Published port on the Docker host; the container still listens on 3001.
APP_PORT=3001
MYSQL_PASSWORD=replace-with-a-long-random-password
# Use the same password as above, URL-encoded in this connection string.
DOCKER_DATABASE_URL=mysql://memties:replace-with-a-long-random-password@db:3306/memties
# Optional outbound HTTP proxies, also used for npm/pnpm during Docker builds.
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1,db
# Application settings belong in APP_ENV_FILE; see deploy/app.env.example.
