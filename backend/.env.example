NODE_ENV=development
# Compact text by default. Use json for a structured log collector.
LOG_FORMAT=pretty
# info shows startup and errors; debug also shows every completed HTTP request.
LOG_LEVEL=info
HOST=127.0.0.1
# Serve a previously built frontend from the backend (Docker enables this).
SERVE_FRONTEND=false
PORT=3001
APP_ORIGIN=http://localhost:5174
DATABASE_URL=mysql://memties:change-me@127.0.0.1:3306/memties
# Set to false after creating accounts to disable public registration.
ALLOW_REGISTRATION=true

# Optional reminder notifications. Emails contain a generic sign-in link only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=memties@example.com
# SMTP_USER=memties@example.com
# SMTP_PASSWORD=replace-me

# Optional LDAP. Use LDAPS; custom trust roots via NODE_EXTRA_CA_CERTS.
# LDAP_URL=ldaps://directory.example.com:636
# LDAP_BIND_DN=cn=memties,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=replace-me
# LDAP_BASE_DN=ou=people,dc=example,dc=com
# LDAP_LOGIN_ATTRIBUTE=uid
# LDAP_ID_ATTRIBUTE=entryUUID
# For Active Directory: sAMAccountName and objectGUID respectively.
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_NAME_ATTRIBUTE=displayName

# Optional SAML. Requires HTTPS APP_ORIGIN, persistent NameID, signed response
# AND assertion. Paths are relative to backend's working directory.
# SAML_ENTRY_POINT=https://idp.example.com/sso
# SAML_IDP_ISSUER=https://idp.example.com
# SAML_IDP_CERT_FILE=./secrets/saml-idp.pem
# Optional: set both SP files only to sign outgoing authentication requests.
# SAML_SP_KEY_FILE=./secrets/sp.key
# SAML_SP_CERT_FILE=./secrets/sp.crt
# SAML_EMAIL_ATTRIBUTE=email
# SAML_NAME_ATTRIBUTE=displayName
# Metadata / entity ID: ${APP_ORIGIN}/api/auth/saml/metadata
# Assertion consumer service: ${APP_ORIGIN}/api/auth/saml/callback

# Optional Web Push. Generate once: pnpm exec web-push generate-vapid-keys --json
# Keep these keys stable across restarts and deployments.
# VAPID_PUBLIC_KEY=replace-me
# VAPID_PRIVATE_KEY=replace-me
# VAPID_SUBJECT=mailto:admin@example.com
