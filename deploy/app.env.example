# Copy to /opt/memties/.env on the Docker server (or APP_ENV_FILE).
# This file is mounted read-only and loaded when the backend starts.
APP_ORIGIN=https://memties.example.com
ALLOW_REGISTRATION=true
# Comma-separated account emails with administrator access.
ADMIN_EMAILS=
LOG_FORMAT=json
LOG_LEVEL=info

# Optional SAML: place the IdP signing certificate on the Docker host at
# /opt/memties/certificate/saml-idp.pem (or under APP_CERTIFICATE_DIR).
# SAML_ENTRY_POINT=https://universe.femto-st.fr/application/saml/memties/sso/binding/redirect/
# SAML_IDP_ISSUER=authentik
# SAML_ONLY=true
# SAML_IDP_CERT_FILE=./certificate/saml-idp.pem
# SAML_EMAIL_ATTRIBUTE=email
# SAML_NAME_ATTRIBUTE=displayName

# Add optional SMTP, LDAP, SAML or VAPID settings from backend/.env.example.
# Docker supplies NODE_ENV, HOST, PORT, SERVE_FRONTEND, DATABASE_URL and proxies.
